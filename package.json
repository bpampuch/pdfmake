{
  "name": "pdfmake",
  "version": "0.3.12",
  "description": "Client/server side PDF printing in pure JavaScript",
  "main": "js/index.js",
  "esnext": "src/index.js",
  "browser": "build/pdfmake.js",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "linebreak": "^1.1.0",
    "pdfkit": "^0.20.2",
    "xmldoc": "^2.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.1.1",
    "brfs": "^2.0.2",
    "buffer": "^6.0.3",
    "core-js": "^3.49.0",
    "eslint": "^10.4.1",
    "eslint-plugin-jsdoc": "^62.9.0",
    "expose-loader": "^5.0.1",
    "file-saver": "^2.0.5",
    "globals": "^17.6.0",
    "mocha": "^12.0.3",
    "npm-run-all": "^4.1.5",
    "process": "^0.11.10",
    "rewire": "^9.0.1",
    "sinon": "^22.0.0",
    "source-map-loader": "^5.0.0",
    "svg-to-pdfkit": "git+https://github.com/alafr/SVG-to-PDFKit.git#b091ebd4e7b7d2310eb1003511cd5de480f7e0e1",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "~5.9.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "run-s schema:check build mocha lint",
    "build": "run-s build:clean build:node build:browser build:standard-fonts build:fonts build:vfs build:types",
    "build:clean": "node scripts/build-tasks.cjs clean",
    "build:3rdparty": "node scripts/build-tasks.cjs third-party",
    "build:node": "node scripts/build-tasks.cjs node",
    "build:browser": "webpack",
    "build:vfs": "node build-vfs.js \"./fonts/Roboto\"",
    "build:examples": "node build-examples.js",
    "build:standard-fonts": "node build-standard-fonts.js",
    "build:fonts": "node scripts/build-tasks.cjs fonts",
    "lint": "eslint \"./src/**/*.js\" \"./tests/**/*.js\" \"./examples/**/*.js\" \"./standard-fonts/**/*.js\" \"./fonts/**/*.js\"",
    "mocha": "mocha --reporter spec \"./tests/**/*.spec.js\"",
    "playground": "run-s build:playground playground:serve",
    "build:playground": "npm --prefix dev-playground ci && node scripts/build-playground.cjs",
    "playground:serve": "node dev-playground/server.js",
    "test:package": "node scripts/test-package.cjs",
    "benchmark:text": "node benchmarks/text-flatten.cjs",
    "release:check": "node scripts/check-release.cjs",
    "test:typescript": "node scripts/test-typescript.cjs",
    "build:types": "node scripts/build-types.cjs",
    "schema:generate": "node scripts/build-document-schema.cjs",
    "schema:check": "node scripts/build-document-schema.cjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/bpampuch/pdfmake.git"
  },
  "keywords": [
    "pdf",
    "javascript",
    "printing",
    "layout"
  ],
  "author": "Bartek Pampuch <bartosz.pampuch@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bpampuch/pdfmake/issues"
  },
  "homepage": "http://pdfmake.org",
  "types": "types/index.d.ts"
}
